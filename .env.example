# Local development only. Replace all values before deployment.
POSTGRES_PASSWORD=jetino_local_only
DATABASE_URL=postgresql://jetino:jetino_local_only@localhost:5432/jetino?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_HMAC_SECRET=replace-with-a-different-random-secret-at-least-32-chars
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
# Public browser key for Neshan Map SDK; restrict allowed origins in the Neshan dashboard.
VITE_NESHAN_API_KEY=
# Server-side Neshan routing key (Api-Key header). Never expose it to the browser.
NESHAN_SERVER_KEY=
NESHAN_DIRECTION_URL=https://api.neshan.org/v4/direction
NESHAN_DIRECTION_TYPE=car
NESHAN_TIMEOUT_MS=3500
