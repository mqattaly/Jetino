DATABASE_URL=postgresql://jetino:jetino_local_only@localhost:5432/jetino?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_HMAC_SECRET=replace-with-a-different-random-secret-at-least-32-chars
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# §7.12 notification delivery
# Web Push needs a VAPID pair (openssl-style key material, base64url). Without both keys nothing is
# pushed: rows are recorded as SKIPPED with 'push-not-configured', never as a fake SENT.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@jetino.app
# The scheduler (Vercel cron: GET /api/v1/notifications/dispatch) authenticates with this.
# The route stays closed while it is unset.
CRON_SECRET=
# Integration harness only: 1 writes payloads to a file instead of a push service. Never set in production.
JETINO_ALLOW_LOCAL_PUSH=
