{
  "name": "@jetino/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"src/**/*.spec.ts\"",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:baseline": "tsx src/database/baseline.ts",
    "admin:promote": "tsx src/database/promote-admin.ts",
    "db:seed:demo": "tsx src/database/seed-demo.ts",
    "db:seed:accounts": "tsx src/database/seed-test-accounts.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore-drill": "bash scripts/restore-drill.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^18.0.10",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
